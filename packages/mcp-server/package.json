{
  "name": "@forgemcp/mcp-server",
  "version": "0.3.0",
  "description": "Official MCP TypeScript SDK adapter for ForgeMCP applications.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./stdio": {
      "types": "./dist/stdio.d.mts",
      "import": "./dist/stdio.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "format": "prettier --check \"src/**/*.ts\" \"package.json\" \"tsconfig.json\" \"tsdown.config.ts\" \"vitest.config.ts\"",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@forgemcp/core": "workspace:*",
    "@modelcontextprotocol/server": "^2.1.0"
  },
  "devDependencies": {
    "@forgemcp/application": "workspace:*",
    "@modelcontextprotocol/client": "^2.1.0",
    "@types/node": "^26.6.4",
    "prettier": "^3.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0",
    "zod": "^4.6.5",
    "@vitest/coverage-v8": "^3.0.0"
  }
}
