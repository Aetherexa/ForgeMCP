{
  "name": "@forgemcp/telemetry-otel",
  "version": "0.4.0",
  "description": "Optional OpenTelemetry adapter for ForgeMCP completed execution telemetry.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "format": "prettier --check \"src/**/*.ts\" \"package.json\" \"tsconfig.json\" \"tsdown.config.ts\" \"vitest.config.ts\"",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@forgemcp/core": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "prettier": "^3.9.9",
    "rimraf": "^6.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@forgemcp/application": "workspace:*",
    "@forgemcp/mcp-server": "workspace:*",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.5"
  }
}
