{
  "name": "@forgemcp/application",
  "version": "0.2.0",
  "description": "Application runtime for ForgeMCP.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "format": "prettier --check \"src/**/*.ts\" \"package.json\" \"tsconfig.json\" \"tsdown.config.ts\" \"vitest.config.ts\"",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@forgemcp/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0",
    "@vitest/coverage-v8": "^5.0.2"
  }
}
